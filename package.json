{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "start:docker": "node dist/main.js",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --reporter=verbose",
    "test:concurrency": "vitest run test/concurrency --reporter=verbose",
    "test:load": "bun run test/load/load.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/nestjs": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@nestjs/terminus": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.3"
  }
}
